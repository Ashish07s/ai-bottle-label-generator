# ============================================
# AI BOTTLE LABEL GENERATOR - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git (it's in .gitignore)
# ============================================

# Your Gemini API Key
# Get it from: Gemini API Keys page: https://console.cloud.google.com/apis/credentials
GEMINI_API_KEY=AIzaSyXXXXX

# Optional: Allowed origin for CORS (your Netlify domain)
# Example: https://your-site-name.netlify.app
ALLOWED_ORIGIN=*

